# Production Environment Configuration

# Server Configuration
NODE_ENV=production
PORT=5000
API_VERSION=v1

# Database Configuration (Use managed database in production)
DB_HOST=your-production-db-host.com
DB_PORT=5432
DB_NAME=civicvoice_production
DB_USER=civicvoice_user
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Redis Configuration (Use managed Redis in production)
REDIS_HOST=your-production-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# JWT Configuration (Generate strong random secrets)
# To generate: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_SECRET_KEY
JWT_REFRESH_SECRET=CHANGE_THIS_TO_STRONG_RANDOM_REFRESH_KEY
JWT_EXPIRATION=30m
JWT_REFRESH_EXPIRATION=7d

# Email Configuration (SendGrid recommended for production)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@civicvoice.org
FROM_NAME=Civic Voice Platform

# Twilio Configuration (for SMS 2FA)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# External APIs
GOOGLE_CIVIC_API_KEY=your-google-civic-api-key
PROPUBLICA_API_KEY=your-propublica-api-key
OPENSTATES_API_KEY=your-openstates-api-key
USPS_API_KEY=your-usps-api-key

# AWS Configuration (for S3 storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_S3_BUCKET=civicvoice-production-documents

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration (Set to your frontend domain)
CORS_ORIGIN=https://civicvoice.org

# File Upload Configuration
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# Application URLs
FRONTEND_URL=https://civicvoice.org
BACKEND_URL=https://api.civicvoice.org

# Logging Configuration
LOG_LEVEL=info

# Monitoring (Optional - for services like Sentry)
SENTRY_DSN=your-sentry-dsn
